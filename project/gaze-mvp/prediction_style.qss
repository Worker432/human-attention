QDialog#predictionWindow { background: #f4f3ef; color: #282d2a; }
QWidget { font-family: "Helvetica Neue"; font-size: 13px; color: #282d2a; }
QLabel { background: transparent; }
QLabel#pageTitle { font-size: 25px; font-weight: 600; }
QLabel#subtitle { color: #72776f; font-size: 13px; }
QLabel#eyebrow { color: #677366; font-size: 11px; }
QLabel#fileName { color: #6b716a; padding: 0px 2px; }
QFrame#inspector { background: #fcfcf9; border: 1px solid #dedfd8; border-radius: 12px; }
QLabel#sectionTitle { font-size: 17px; font-weight: 600; }
QLabel#resultSummary { color: #72776f; }
QLabel#caption, QLabel#stepDetail { color: #72776f; font-size: 12px; }
QLabel#status { color: #586851; font-size: 12px; }
QLabel#stepCount { color: #626a60; min-width: 100px; }
QPushButton { background: #fcfcf9; border: 1px solid #d7dbd2; border-radius: 7px; padding: 9px 14px; }
QPushButton:hover { background: #ecefe8; border-color: #b8c4b1; }
QPushButton:pressed { background: #e1e8dc; }
QPushButton:focus { border-color: #477746; }
QPushButton:disabled { color: #a0a69a; border-color: #e3e5df; background: #f0f1ed; }
QPushButton[primary="true"] { background: #365e3e; color: #ffffff; border-color: #365e3e; }
QPushButton[primary="true"]:hover { background: #294d31; }
QPushButton[primary="true"]:disabled { background: #cbd3c5; border-color: #cbd3c5; color: #f7f8f5; }
QToolButton { border: 0; background: transparent; color: #626b5d; padding: 8px 0; text-align: left; }
QToolButton:hover { color: #2d5137; }
QToolButton:checked { color: #2d5137; }
QCheckBox { spacing: 7px; background: transparent; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #aeb9a7; border-radius: 4px; background: #fcfcf9; }
QCheckBox::indicator:checked { background: #365e3e; border-color: #365e3e; image: url(__CHECK_ICON__); }
QCheckBox:disabled { color: #a0a69a; }
QSpinBox { padding: 6px 9px; background: #ffffff; color: #282d2a; border: 1px solid #d7dbd2; border-radius: 6px; min-width: 68px; }
QSpinBox QLineEdit { background: #ffffff; color: #282d2a; }
QTableWidget { border: 0; background: #fcfcf9; alternate-background-color: #fcfcf9; gridline-color: transparent; outline: 0; selection-background-color: #e8eee2; selection-color: #294532; }
QTableWidget::item { border-bottom: 1px solid #edefe7; padding: 8px 6px; color: #56604f; }
QTableWidget::item:selected { background: #e8eee2; color: #294532; }
QTableWidget::item:hover { background: #f0f3eb; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: #ced4c7; border-radius: 3px; min-height: 25px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QSlider::groove:horizontal { background: #d8ddd3; height: 4px; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #638362; border-radius: 2px; }
QSlider::handle:horizontal { background: #365e3e; border: 2px solid #f4f3ef; width: 13px; height: 13px; border-radius: 8px; margin: -6px 0; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QTabWidget::pane { border: 0; background: #fcfcf9; }
QTabBar::tab { background: #f0f1eb; color: #72776f; border: 0; padding: 8px 14px; }
QTabBar::tab:selected { background: #e8eee2; color: #294532; }
QHeaderView::section { background: #f0f1eb; color: #626a60; border: 0; padding: 6px 3px; }
